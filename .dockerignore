# Never bake secrets or eval live output into the image.
.env
.env.*
!.env.example
eval/results/
eval/history.csv
eval/.checkpoint.json
eval/.checkpoint.json.tmp
eval/checkpoints/
docs/evaluation.md
docs/evaluation.partial.md
panel/node_modules/
panel/dist/
.venv/
__pycache__/
.git/
# Database dumps/backups: never in the build context.
*.dump
*.sql.gz
db-backup.sql
backup/
# Dev-only trees and caches (the Dockerfile copies only src/, db/, demo/).
tests/
.github/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.pyc
