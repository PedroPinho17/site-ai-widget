# Copy to .env and fill in: cp .env.example .env
# Generate secrets with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://sitewidget:change-me@127.0.0.1:5435/sitewidget

# Demo admin passwords (required by seed; never hardcoded)
DEMO_PASSWORD_ATLAS=
DEMO_PASSWORD_LIMA=
# 1 = docker compose seeds the demo companies + PDFs on start (default 0)
# RUN_SEED=1

# --- API --------------------------------------------------------------------
# At least 32 random characters, or the API refuses to start.
JWT_SECRET=
# Host port when running via docker compose (container listens on 8002)
APP_PORT=8002
# 1 enables Swagger at /docs
ENABLE_DOCS=0
# 1 opens POST /auth/register (anyone can create a company + admin). Keep 0 on a
# public deployment; the demo companies are created by the seed.
# ALLOW_REGISTRATION=0
# Comma-separated origins of the Vite admin panel. Never "*".
PANEL_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Peers whose CF-Connecting-IP / X-Forwarded-For we trust (comma-separated IPs/CIDRs).
# Default when unset: loopback only (127.0.0.1,::1).
# TRUSTED_PROXY_IPS=172.18.0.0/16

# Rate limits (in-memory, per process)
# AUTH_RATE_LIMIT=10
# AUTH_RATE_LIMIT_WINDOW=300
# API_RATE_LIMIT=120
# API_RATE_LIMIT_WINDOW=60
# Minimum 3: one /ask call uses 3 slots; a lower value fails at startup.
# ASK_RATE_LIMIT=20
# ASK_RATE_LIMIT_WINDOW=600

# JWT session length in hours
# JWT_HOURS=8

# --- Documents / RAG (Phase 2) ----------------------------------------------
# UPLOAD_DIR=data/uploads
# MAX_UPLOAD_MB=25
# MAX_PDF_PAGES=300
# MAX_DOCUMENTS=50
# MAX_QUESTION_CHARS=1000
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# First run downloads the embedding model once (cached under HF_HOME).

# Seconds a document may stay in "processing" before seed treats it as stuck
# (avoids resetting a job a live API worker is still handling). Default 180.
# DOCUMENT_STUCK_PROCESSING_SECONDS=180

# Groq (OpenAI-compatible). The API starts without these; /ask/docs returns 503.
GROQ_API_KEY=
# Optional second key used automatically on HTTP 429 / quota
GROQ_API_KEY_FALLBACK=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Request timeout for chat completions (seconds). Default 60.
# LLM_TIMEOUT_SECONDS=60


# Demo client database (Mercearia Atlas), Phase 3.
# Only used when the clientdata volume is first created (see README).
CLIENTDB_PASSWORD=
ATLAS_READONLY_PASSWORD=

# Phase 3: Fernet key that encrypts saved client DB connections. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not change it after connections are saved: they become unreadable and
# must be saved again.
CONNECTIONS_KEY=

# Phase 3: private/local host:port pairs the connection test may reach anyway
# (the demo client DB). Locally 127.0.0.1:5436; inside Docker clientdb:5432.
CLIENTDB_ALLOWED_HOSTS=
